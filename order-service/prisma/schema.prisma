generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id        Int      @id @default(autoincrement())
  userId    Int
  userEmail String
  total     Float
  status    String   @default("CREATED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}
